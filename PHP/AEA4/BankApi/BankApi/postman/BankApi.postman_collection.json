{
  "info": {
    "name": "BankApi",
    "_postman_id": "b4e1c0e2-0001-4000-a000-000000000001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "categoriaId", "value": "" },
    { "key": "preguntaId", "value": "" },
    { "key": "partidaId", "value": "" },
    { "key": "respostaId", "value": "" },
    { "key": "xsrfToken", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.collectionVariables.get('xsrfToken');",
          "if (token) {",
          "  pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: token });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login (GET CSRF)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jar = pm.cookies.jar();",
              "const baseUrl = pm.variables.replaceIn('{{baseUrl}}');",
              "jar.get(baseUrl, 'XSRF-TOKEN', (err, value) => {",
              "  if (err || !value) {",
              "    console.warn('XSRF-TOKEN cookie not found');",
              "    return;",
              "  }",
              "  const token = decodeURIComponent(value);",
              "  pm.collectionVariables.set('xsrfToken', token);",
              "  console.log('Stored XSRF-TOKEN:', token);",
              "});",
              "",
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('XSRF-TOKEN cookie is set', () => {",
              "  pm.expect(pm.cookies.has('XSRF-TOKEN')).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "text/html" }],
        "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] }
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const baseUrl = pm.variables.replaceIn('{{baseUrl}}');",
              "pm.sendRequest({ url: baseUrl + '/login', method: 'GET' }, (err, _res, cookies) => {",
              "  if (err) return;",
              "  const token = cookies && cookies.get && cookies.get('XSRF-TOKEN');",
              "  if (token) pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: decodeURIComponent(token) });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] }
      }
    },
